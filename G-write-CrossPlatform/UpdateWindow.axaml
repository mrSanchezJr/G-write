<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="G_write.UpdateWindow"
        Title="Проверка обновлений"
        Width="380" Height="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock Text="Проверка обновлений" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="label2" Text="Проверка связи с сервером..." TextWrapping="Wrap" TextAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15" Margin="0,10,0,0">
            <Button x:Name="button1" Content="Перейти на GitHub" IsEnabled="False" Click="Button1_Click"/>
            <Button x:Name="button2" Content="Закрыть" Click="Button2_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
