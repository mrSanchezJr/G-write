<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="G_write.UpdateWindow"
        Title="Проверка обновлений"
        Width="460" Height="280"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Проверка обновлений" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="label2" Text="Проверка связи с GitHub..." TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="#333333" Margin="4,0"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,14,0,0">
            <Button x:Name="button1" Content="Перейти на GitHub" Width="180" Height="38" HorizontalContentAlignment="Center" Click="Button1_Click" IsEnabled="False"/>
            <Button x:Name="button2" Content="Закрыть" Width="110" Height="38" HorizontalContentAlignment="Center" Click="Button2_Click"/>
        </StackPanel>
    </Grid>
</Window>
