<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="G_write.MiniWindow"
        Title="ASIS-3AX (Мини)"
        Width="320" Height="370"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Icon="avares://G-write/Assets/skp.ico"
        Background="#F5F5F5"
        FontSize="13.5">

    <Grid Margin="12" RowDefinitions="Auto,*,Auto">
        <!-- Шапка: Кнопка Развернуть -->
        <Button Grid.Row="0" x:Name="btnExpand" Click="Expand_Click" Margin="0,0,0,10"
                HorizontalAlignment="Stretch" Height="40"
                Background="#1A73E8" Foreground="White" FontWeight="SemiBold" FontSize="13"
                Padding="10,4" CornerRadius="6" Cursor="Hand"
                ToolTip.Tip="Вернуться в полноразмерное окно программы">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Image Source="avares://G-write/Assets/icon_expand.png" Width="26" Height="26" VerticalAlignment="Center"/>
                <TextBlock Text="Развернуть" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Основные кнопки действий ЧПУ -->
        <Grid Grid.Row="1" RowDefinitions="*,*,*,*" Margin="0,0,0,10">
            <!-- 1. В начало -->
            <Button Grid.Row="0" x:Name="btnHome" Margin="0,2.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="#F0F0F0" Foreground="#222222" FontWeight="SemiBold" FontSize="13.5"
                    Click="Home_Click" ToolTip.Tip="Переход в координаты начала сканирования">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Image Source="avares://G-write/Assets/icon_home.png" Width="34" Height="34" VerticalAlignment="Center"/>
                    <TextBlock Text="В начало" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 2. Отправить -->
            <Button Grid.Row="1" x:Name="btnSend" Margin="0,2.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="#DAE8FC" Foreground="#0D47A1" FontWeight="Bold" FontSize="14"
                    Click="Send_Click" ToolTip.Tip="Запуск выполнения G-кода сканирования">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Image Source="avares://G-write/Assets/icon_send.png" Width="34" Height="34" VerticalAlignment="Center"/>
                    <TextBlock Text="Отправить" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 3. Пауза / Возобновить -->
            <Button Grid.Row="2" x:Name="btnPause" Margin="0,2.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="#FFF2CC" Foreground="#7F6000" FontWeight="SemiBold" FontSize="13.5"
                    Click="Pause_Click" ToolTip.Tip="Приостановить или возобновить выполнение">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Image x:Name="imgBtnPause" Source="avares://G-write/Assets/icon_pause.png" Width="34" Height="34" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtBtnPause" Text="Пауза" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 4. СТОП / РАЗБЛОК -->
            <Button Grid.Row="3" x:Name="btnStop" Margin="0,2.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="#D9534F" Foreground="White" FontWeight="Bold" FontSize="14.5"
                    Click="Stop_Click" ToolTip.Tip="Экстренный останов / разблокировка контроллера">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Image x:Name="imgBtnStop" Source="avares://G-write/Assets/icon_stop.png" Width="34" Height="34" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtBtnStop" Text="СТОП" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Блок прогресса -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="8,6">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Прогресс:" FontWeight="SemiBold" FontSize="12" Foreground="#444444"/>
                    <TextBlock Grid.Column="1" x:Name="lblProgressText" Text="0% (0 / 0)" FontWeight="Bold" FontSize="12" Foreground="#1A73E8"/>
                </Grid>
                <ProgressBar x:Name="miniProgressBar" Height="26" Minimum="0" Maximum="100" Value="0"
                             ShowProgressText="False" CornerRadius="4"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
