<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="G_write.MiniWindow"
        Title="ASIS-3AX (Мини)"
        Width="320" Height="410"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Icon="avares://G-write/Assets/skp.ico"
        Background="#F5F5F5"
        FontSize="13">

    <Grid Margin="12" RowDefinitions="Auto,*,Auto">
        <!-- Шапка: Название программы + Кнопка Развернуть -->
        <Border Grid.Row="0" Background="#E8F0FE" BorderBrush="#BED5F6" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="ASIS-3AX" FontWeight="Bold" FontSize="14" Foreground="#1A237E"/>
                    <TextBlock Text="Компактный пульт" FontSize="11" Foreground="#555555"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="btnExpand" Content="⤢ Развернуть" Click="Expand_Click"
                        Background="#1A73E8" Foreground="White" FontWeight="SemiBold" FontSize="12"
                        Padding="10,6" CornerRadius="4" Cursor="Hand"
                        ToolTip.Tip="Вернуться в полноразмерное окно программы"/>
            </Grid>
        </Border>

        <!-- Основные кнопки действий ЧПУ -->
        <Grid Grid.Row="1" RowDefinitions="*,*,*,*,*" Margin="0,0,0,10">
            <!-- 1. Генерировать -->
            <Button Grid.Row="0" x:Name="btnGen" Margin="0,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="#D5E8D4" Foreground="#1E4620" FontWeight="SemiBold" FontSize="13"
                    Click="Gen_Click" ToolTip.Tip="Генерация траектории сканирования">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Text="Генерировать" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 2. В начало -->
            <Button Grid.Row="1" x:Name="btnHome" Margin="0,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="#F0F0F0" Foreground="#222222" FontWeight="SemiBold" FontSize="13"
                    Click="Home_Click" ToolTip.Tip="Переход в координаты начала сканирования">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="⏮" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="В начало" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 3. Отправить -->
            <Button Grid.Row="2" x:Name="btnSend" Margin="0,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="#DAE8FC" Foreground="#0D47A1" FontWeight="Bold" FontSize="13.5"
                    Click="Send_Click" ToolTip.Tip="Запуск выполнения G-кода сканирования">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="▶" FontSize="14" Foreground="#0D47A1" VerticalAlignment="Center"/>
                    <TextBlock Text="Отправить" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 4. Пауза / Возобновить -->
            <Button Grid.Row="3" x:Name="btnPause" Margin="0,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="#FFF2CC" Foreground="#7F6000" FontWeight="SemiBold" FontSize="13"
                    Click="Pause_Click" ToolTip.Tip="Приостановить или возобновить выполнение">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock x:Name="txtIconPause" Text="⏸" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtBtnPause" Text="Пауза" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 5. СТОП / РАЗБЛОК -->
            <Button Grid.Row="4" x:Name="btnStop" Margin="0,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="#D9534F" Foreground="White" FontWeight="Bold" FontSize="14"
                    Click="Stop_Click" ToolTip.Tip="Экстренный останов / разблокировка контроллера">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock x:Name="txtIconStop" Text="🛑" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtBtnStop" Text="СТОП" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Блок прогресса -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="8,6">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Прогресс:" FontWeight="SemiBold" FontSize="12" Foreground="#444444"/>
                    <TextBlock Grid.Column="1" x:Name="lblProgressText" Text="0% (0 / 0)" FontWeight="Bold" FontSize="12" Foreground="#1A73E8"/>
                </Grid>
                <ProgressBar x:Name="miniProgressBar" Height="26" Minimum="0" Maximum="100" Value="0"
                             ShowProgressText="False" CornerRadius="4"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
