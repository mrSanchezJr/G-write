<!--
  =============================================================================
  G-WRITE (ASIS-3AX) - КРОССПЛАТФОРМЕННЫЙ ИНТЕРФЕЙС УПРАВЛЕНИЯ ЧПУ (WINDOWS / LINUX)
  =============================================================================
  АВТОМАТИЧЕСКАЯ АДАПТАЦИЯ И МАСШТАБИРОВАНИЕ (VIEWBOX):
  Весь интерфейс помещен в контейнер <Viewbox Stretch="Uniform">.
  Это позволяет пользователю просто тянуть за любой угол окна:
  - При уменьшении окна весь интерфейс пропорционально уменьшается без сдвигов и наложений.
  - При разворачивании на весь экран или увеличении окна интерфейс пропорционально увеличивается.
  - Никаких ручных настроек масштаба или полос прокрутки — всё масштабируется на лету!
  =============================================================================
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:G_write"
        x:Class="G_write.MainWindow"
        Title=" ASIS-3AX"
        Width="1440" Height="860"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontSize="13"
        Icon="avares://G-write/Assets/skp.ico"
        Background="#F0F0F0">

    <!-- ================= СТИЛИ ОФОРМЛЕНИЯ ================= -->
    <Window.Styles>
        <!-- Стиль карточки-группы (аналог GroupBox в WinForms) -->
        <Style Selector="Border.groupCard">
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#FBFBFB"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- Стиль заголовка группы -->
        <Style Selector="TextBlock.groupTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Стиль больших квадратных кнопок джога (перемещение осей) -->
        <Style Selector="Button.jogBtn">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#EAEAEA"/>
        </Style>

        <!-- Стиль функциональных кнопок действий -->
        <Style Selector="Button.actBtn">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <!-- Стиль терминала: чисто белый фон, черный текст, без эффектов при наведении и фокусе -->
        <Style Selector="TextBox.terminalBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="CaretBrush" Value="Black"/>
            <Setter Property="SelectionBrush" Value="#0078D7"/>
            <Setter Property="SelectionForegroundBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.terminalBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.terminalBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.terminalBox:pointerover:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.terminalBox:pointerover">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="TextBox.terminalBox:focus">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="TextBox.terminalBox:disabled /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <!-- 
      VIEWBOX: Автоматически масштабирует всё содержимое пропорционально размерам окна.
      Просто потяните за угол окна — весь интерфейс плавно увеличится или уменьшится!
    -->
    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="1440" Height="860" RowDefinitions="Auto,*" Margin="6">

            <!-- ========================================================================= -->
            <!-- ВЕРХНЯЯ ПАНЕЛЬ: ПОДКЛЮЧЕНИЕ, ФАЙЛЫ, СИСТЕМНЫЕ КНОПКИ И ВЕРСИЯ             -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,4">

                <!-- Блок подключения к контроллеру (аналог groupBox1 из Form1) -->
                <Border Grid.Column="0" Classes="groupCard" Width="480">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Подключение к контроллеру (COM / TCP Wi-Fi)" Classes="groupTitle"/>
                        <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" Margin="2">

                            <!-- Переключатель режима: COM (USB Serial) или TCP Wi-Fi (мост ESP-32S) -->
                            <RadioButton Grid.Row="0" Grid.Column="0" x:Name="rbSerial" Content="COM-порт"
                                         IsCheckedChanged="rbSerial_CheckedChanged" Margin="0,0,16,6"/>
                            <RadioButton Grid.Row="0" Grid.Column="1" x:Name="rbTcp" Content="Wi-Fi (TCP)"
                                         IsChecked="True" IsCheckedChanged="rbTcp_CheckedChanged" Margin="0,0,16,6"/>

                            <!-- Текстовый индикатор текущего статуса подключения -->
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="lblConnStatus" Text="Отключено"
                                       Foreground="DimGray" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <!-- Элементы управления COM-портом (видны только при выборе режима COM) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6"
                                        x:Name="pnlSerial" IsVisible="False">
                                <local:EditableComboBox x:Name="comboBox1" Width="170" ToolTip.Tip="Выбор последовательного порта (COMx / /dev/ttyUSB*)"/>
                                <Button x:Name="button2" Content="Обновить" Classes="actBtn" Click="button2_Click"
                                        ToolTip.Tip="Пересканировать доступные порты в системе"/>
                            </StackPanel>

                            <!-- Элементы управления TCP Wi-Fi (видны только при выборе режима Wi-Fi) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6"
                                        x:Name="pnlTcp" IsVisible="True">
                                <TextBlock x:Name="lblTcpIp" Text="IP:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtTcpIp" Text="192.168.4.1" Width="140" ToolTip.Tip="IP-адрес контроллера ESP-32S в сети Wi-Fi"/>
                                <TextBlock x:Name="lblTcpPort" Text="Порт:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtTcpPort" Text="8088" Width="60" ToolTip.Tip="TCP-порт моста (по умолчанию 8088)"/>
                            </StackPanel>

                            <!-- Главная кнопка подключения / отключения (button1) -->
                            <Button Grid.Row="1" Grid.Column="2" x:Name="button1" Content="Подключить"
                                    Classes="actBtn" Width="120" Height="32" HorizontalAlignment="Right"
                                    Background="#E1E1E1" Click="button1_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Блок работы с файлами G-кода (аналог groupBox7 из Form1) -->
                <Border Grid.Column="1" Classes="groupCard" Width="330">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Файл 📁" Classes="groupTitle"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,4,4,4">
                            <!-- Кнопка сохранения сгенерированного файла (button16) -->
                            <Button x:Name="button16" Classes="actBtn" Width="140" Height="38" Click="button16_Click"
                                    ToolTip.Tip="Сохранить текущую сгенерированную траекторию в файл .gcode">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Кнопка открытия и разбора файла G-кода (button17) -->
                            <Button x:Name="button17" Classes="actBtn" Width="140" Height="38" Click="button17_Click"
                                    ToolTip.Tip="Открыть файл .gcode и считать сохраненные параметры">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="📂" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Загрузить" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Верхний правый угол: Экранная клавиатура, О программе, Обновление, Версия -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,8,0">
                    <!-- Кнопка вызова сенсорной цифровой клавиатуры Numpad -->
                    <Button x:Name="ToggleNumpadButton" Classes="actBtn" Height="44" Padding="8,2" Click="ToggleNumpadButton_Click"
                            ToolTip.Tip="Показать/скрыть плавающую сенсорную клавиатуру для ввода чисел">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Image Source="avares://G-write/Assets/icons_keyboard.png" Width="26" Height="26"/>
                            <TextBlock x:Name="txtNumpad" Text="Экранная&#x0a;Клавиатура" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Диалоговые кнопки -->
                    <Button x:Name="button9" Content="О программе" Classes="actBtn" Height="44" Click="button9_Click_2"/>
                    <Button x:Name="button8" Content="Обновить" Classes="actBtn" Height="44" Click="button8_ClickAsync"/>

                    <!-- Метка версии -->
                    <TextBlock x:Name="label12" Text="Ver: 2.0.1" FontWeight="Bold" Foreground="#666666"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ========================================================================= -->
            <!-- ОСНОВНАЯ ОБЛАСТЬ: 3 КОЛОНКИ (ПЛАН СКАНИРОВАНИЯ | ДЖОГ | МОНИТОР ТЕРМИНАЛА) -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1" ColumnDefinitions="480,560,*">

                <!-- ===================================================================== -->
                <!-- КОЛОНКА 1: ПЛАН СКАНИРОВАНИЯ (ЗИГЗАГ) - аналог панели Zigzag в Form1 -->
                <!-- ===================================================================== -->
                <Border Grid.Column="0" Classes="groupCard" x:Name="Zigzag">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <TextBlock Text="План сканирования" Classes="groupTitle"/>

                            <!-- Точка A (Начальные координаты сканирования) -->
                            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="6" Background="#FAFAFA">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Точка A (Начало)" FontWeight="SemiBold" Foreground="#0055AA"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" x:Name="startPosX" Text="0.0"/>
                                        <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="3" x:Name="startPosY" Text="0.0"/>
                                        <!-- Кнопка считывания текущего положения станка в точку A (button6) -->
                                        <Button Grid.Column="4" x:Name="button6" Content="Текущие" Classes="actBtn"
                                                Margin="8,0,0,0" ToolTip.Tip="Записать текущие координаты станка в точку A"
                                                Click="button6_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Точка B (Конечные координаты сканирования) -->
                            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="6" Background="#FAFAFA">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Точка B (Конец)" FontWeight="SemiBold" Foreground="#0055AA"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" x:Name="endPosX" Text="0.0"/>
                                        <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="3" x:Name="endPosY" Text="0.0"/>
                                        <!-- Кнопка считывания текущего положения станка в точку B (button7) -->
                                        <Button Grid.Column="4" x:Name="button7" Content="Текущие" Classes="actBtn"
                                                Margin="8,0,0,0" ToolTip.Tip="Записать текущие координаты станка в точку B"
                                                Click="button7_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Скорость и шаг растра -->
                            <Grid ColumnDefinitions="*,*">
                                <!-- Скорость сканирования (comboBox4) -->
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                    <TextBlock Text="Скорость" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <local:EditableComboBox x:Name="comboBox4" Width="140"/>
                                        <TextBlock Text="мм/с" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Шаг между проходами зигзага (comboBox2) -->
                                <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                    <TextBlock Text="Шаг" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <local:EditableComboBox x:Name="comboBox2" Width="140"/>
                                        <TextBlock Text="мм" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Расчетное время сканирования -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="6" Background="#F5F5F5">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="Время сканирования:" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="label16" Text="0" FontWeight="Bold" Foreground="#008000"/>
                                    <TextBlock Text="сек."/>
                                </StackPanel>
                            </Border>

                            <Separator Height="1" Background="#DDDDDD" Margin="0,4"/>

                            <!-- Кнопки управления выполнением программы сканирования -->
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4">
                                <!-- Кнопка генерации зигзага (genButton) -->
                                <Button Grid.Row="0" Grid.Column="0" x:Name="genButton" Classes="actBtn" Height="44" Width="140" Margin="3"
                                        Background="#D5E8D4" Click="genButton_Click"
                                        ToolTip.Tip="Генерация траектории сканирования">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <Image Source="avares://G-write/Assets/icon_gen.png" Width="22" Height="22"/>
                                        <TextBlock Text="Генерировать" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Кнопка быстрого возврата в точку начала (button12) -->
                                <Button Grid.Row="1" Grid.Column="0" x:Name="button12" Classes="actBtn" Height="44" Width="140" Margin="3" Click="button12_Click"
                                        ToolTip.Tip="Переход в координаты начала сканирования">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <Image Source="avares://G-write/Assets/icon_home.png" Width="22" Height="22"/>
                                        <TextBlock Text="В начало" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Кнопка запуска потоковой отправки G-кода (button3) -->
                                <Button Grid.Row="2" Grid.Column="0" x:Name="button3" Classes="actBtn" Height="46" Width="140" Margin="3"
                                        FontWeight="Bold" Background="#DAE8FC" Click="button3_Click"
                                        ToolTip.Tip="Запуск выполнения G-кода сканирования">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <Image Source="avares://G-write/Assets/icon_send.png" Width="22" Height="22"/>
                                        <TextBlock Text="Отправить" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Кнопка Пауза / Возобновить (button11) -->
                                <Button Grid.Row="3" Grid.Column="0" x:Name="button11" Classes="actBtn" Height="46" Width="140" Margin="3"
                                        Background="#FFF2CC" Click="button11_Click"
                                        ToolTip.Tip="Приостановить или возобновить выполнение">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <Image x:Name="imgButton11" Source="avares://G-write/Assets/icon_pause.png" Width="22" Height="22"/>
                                        <TextBlock x:Name="txtButton11" Text="Пауза" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Кнопка Аварийного останова и сброса (button10) -->
                                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="button10" Classes="actBtn"
                                        Height="44" Width="369" Margin="2,4,2,2" Background="#D9534F" Foreground="White" Click="button10_Click_1"
                                        ToolTip.Tip="Экстренный останов / разблокировка контроллера">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <Image x:Name="imgButton10" Source="avares://G-write/Assets/icon_stop.png" Width="24" Height="24" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtButton10" Text="СТОП" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Индикатор прогресса передачи кадров G-кода -->
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock x:Name="label10" Text="Прогресс: Ожидание" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="progressBar1" Height="42" Minimum="0" Maximum="100" Value="0"
                                             ShowProgressText="True"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ===================================================================== -->
                <!-- КОЛОНКА 2: РУЧНОЕ УПРАВЛЕНИЕ (ДЖОГ) - аналог панели Control в Form1   -->
                <!-- ===================================================================== -->
                <Border Grid.Column="1" Classes="groupCard" x:Name="Control">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Управление" Classes="groupTitle"/>

                            <!-- Монитор текущих координат станка X, Y, Z и кнопка сброса -->
                            <Border BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="4" Padding="8" Background="#F0F8FF">
                                <Grid ColumnDefinitions="*,*,*,Auto">
                                    <TextBlock Grid.Column="0" x:Name="label17" Text="X: 0.0" FontSize="16" FontWeight="Bold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="label18" Text="Y: 0.0" FontSize="16" FontWeight="Bold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="label19" Text="Z: 0.0" FontSize="16" FontWeight="Bold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <!-- Кнопка программного обнуления координат (button14) -->
                                    <Button Grid.Column="3" x:Name="button14" Classes="actBtn" Width="85" Height="36"
                                            Background="#FFF0F0" Foreground="#C00000"
                                            ToolTip.Tip="Обнулить текущие координаты станка (G10 L20 P1 X0 Y0 Z0)" Click="button14_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <TextBlock Text="⟲" FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Сброс" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Джойстики ручного перемещения по осям XY и Z -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <!-- Джойстик перемещений по осям X и Y (аналог groupBox2) -->
                                <Border Grid.Column="0" Classes="groupCard" Margin="0,0,6,0">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="X Y" Classes="groupTitle"/>
                                        <Grid RowDefinitions="64,64,64" ColumnDefinitions="80,80,80" HorizontalAlignment="Center">
                                            <!-- ВВЕРХ (Y+) -->
                                            <Button Grid.Row="0" Grid.Column="1" x:Name="buttonUpXY" Classes="jogBtn"
                                                    Width="76" Height="62" Click="buttonUpXY_Click" ToolTip.Tip="Перемещение Y+">
                                                <Image Source="avares://G-write/Assets/btn_buttonUpXY.png" Width="44" Height="44" Stretch="Uniform"/>
                                            </Button>
                                            <!-- ВЛЕВО (X-) -->
                                            <Button Grid.Row="1" Grid.Column="0" x:Name="buttonLeftXY" Classes="jogBtn"
                                                    Width="76" Height="62" Click="buttonLeftXY_Click" ToolTip.Tip="Перемещение X-">
                                                <Image Source="avares://G-write/Assets/btn_buttonLeftXY.png" Width="44" Height="44" Stretch="Uniform"/>
                                            </Button>
                                            <!-- HOME XY (возврат к датчикам XY) -->
                                            <Button Grid.Row="1" Grid.Column="1" x:Name="buttonHomeXY" Classes="jogBtn"
                                                    Width="76" Height="62" Click="buttonHomeXY_Click" ToolTip.Tip="Home XY (G28 X0 Y0)">
                                                <Image Source="avares://G-write/Assets/btn_buttonHomeXY.png" Width="44" Height="44" Stretch="Uniform"/>
                                            </Button>
                                            <!-- ВПРАВО (X+) -->
                                            <Button Grid.Row="1" Grid.Column="2" x:Name="buttonRightXY" Classes="jogBtn"
                                                    Width="76" Height="62" Click="buttonRightXY_Click" ToolTip.Tip="Перемещение X+">
                                                <Image Source="avares://G-write/Assets/btn_buttonRightXY.png" Width="44" Height="44" Stretch="Uniform"/>
                                            </Button>
                                            <!-- ВНИЗ (Y-) -->
                                            <Button Grid.Row="2" Grid.Column="1" x:Name="buttonDownXY" Classes="jogBtn"
                                                    Width="76" Height="62" Click="buttonDownXY_Click" ToolTip.Tip="Перемещение Y-">
                                                <Image Source="avares://G-write/Assets/btn_buttonDownXY.png" Width="44" Height="44" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Джойстик перемещений по вертикальной оси Z (аналог groupBox4) -->
                                <Border Grid.Column="1" Classes="groupCard" Width="180">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Z" Classes="groupTitle"/>
                                        <Grid RowDefinitions="64,64,64" ColumnDefinitions="80,80" HorizontalAlignment="Center">
                                            <!-- ВВЕРХ Z+ -->
                                            <Button Grid.Row="0" Grid.Column="0" x:Name="buttonUpZ" Classes="jogBtn"
                                                    Width="76" Height="62" Click="buttonUpZ_Click" ToolTip.Tip="Подъем Z+">
                                                <Image Source="avares://G-write/Assets/btn_buttonUpZ.png" Width="44" Height="44" Stretch="Uniform"/>
                                            </Button>
                                            <!-- ВНИЗ Z- -->
                                            <Button Grid.Row="1" Grid.Column="0" x:Name="buttonDownZ" Classes="jogBtn"
                                                    Width="76" Height="62" Click="buttonDownZ_Click" ToolTip.Tip="Опускание Z-">
                                                <Image Source="avares://G-write/Assets/btn_buttonDownZ.png" Width="44" Height="44" Stretch="Uniform"/>
                                            </Button>
                                            <!-- HOME Z -->
                                            <Button Grid.Row="1" Grid.Column="1" x:Name="buttonHomeZ" Classes="jogBtn"
                                                    Width="76" Height="62" Click="buttonHomeZ_Click" ToolTip.Tip="Home Z (G28 Z0)">
                                                <Image Source="avares://G-write/Assets/btn_buttonHomeZ.png" Width="44" Height="44" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Выбор шага и скорости ручного перемещения -->
                            <Grid ColumnDefinitions="*,*">
                                <!-- Переключатели шага джога в мм (аналог groupBox5) -->
                                <Border Grid.Column="0" Classes="groupCard" Margin="0,0,4,0">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Шаг (мм)" Classes="groupTitle"/>
                                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                                            <RadioButton Grid.Row="0" Grid.Column="0" x:Name="radioButton1" Content="0.1" Click="radioButton1_CheckedChanged"/>
                                            <RadioButton Grid.Row="0" Grid.Column="1" x:Name="radioButton2" Content="1" Click="radioButton2_CheckedChanged"/>
                                            <RadioButton Grid.Row="0" Grid.Column="2" x:Name="radioButton3" Content="5" Click="radioButton4_CheckedChanged"/>
                                            <RadioButton Grid.Row="1" Grid.Column="0" x:Name="radioButton4" Content="10" IsChecked="True" Click="radioButton3_CheckedChanged"/>
                                            <RadioButton Grid.Row="1" Grid.Column="1" x:Name="radioButton5" Content="50" Click="radioButton5_CheckedChanged"/>
                                            <RadioButton Grid.Row="1" Grid.Column="2" x:Name="radioButton6" Content="100" Click="radioButton6_CheckedChanged"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Выбор скорости джога в мм/с (аналог groupBox6) -->
                                <Border Grid.Column="1" Classes="groupCard" Margin="4,0,0,0">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Скорость ручного джога" Classes="groupTitle"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                            <local:EditableComboBox x:Name="comboBox3" Width="140"
                                                                    SelectionChanged="comboBox3_SelectedIndexChanged"/>
                                            <TextBlock Text="мм/с" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Блок поиска баз по концевикам (аналог groupBox8) -->
                            <Border Classes="groupCard">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Поиск нуля" Classes="groupTitle"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Поиск начальной координаты&#x0a;по концевикам ($H)"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <!-- Кнопка аппаратного поиска нуля ($H / $X) (button15) -->
                                        <Button Grid.Column="1" x:Name="button15" Content="Поиск нуля"
                                                Classes="actBtn" Width="150" Height="42"
                                                Background="#DAE8FC" Foreground="#0055AA" Click="button15_Click_1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ===================================================================== -->
                <!-- КОЛОНКА 3: ТЕРМИНАЛ И НАСТРОЙКИ UI (аналог groupBox3 в Form1)         -->
                <!-- ===================================================================== -->
                <Border Grid.Column="2" Classes="groupCard" x:Name="groupBox3">
                    <Grid RowDefinitions="Auto,*,Auto,Auto">

                        <!-- Поле ручного ввода произвольных G-код команд -->
                        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,6">
                            <TextBlock Text="G-код консоль" Classes="groupTitle"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" x:Name="customBox" KeyDown="customBox_KeyDown"
                                         Watermark="Введите G-код команду (напр. G0 X10 или $$)..."/>
                                <Button Grid.Column="1" x:Name="button4" Content="Отправить" Classes="actBtn"
                                        Margin="6,0,0,0" Height="32" Click="Button4_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Окно терминала (моноширинный вывод с авто-очисткой старых строк) -->
                        <Border Grid.Row="1" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="4" Background="White" Margin="0,0,0,6">
                            <TextBox x:Name="box" Classes="terminalBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas, Menlo, Courier New, monospace"
                                     FontSize="12.5"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <!-- Кнопка очистки текста терминала (button5) -->
                        <Button Grid.Row="2" x:Name="button5" Content="Очистить терминал" Classes="actBtn"
                                HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,6" Click="button5_Click"/>

                        <!-- Панель прозрачности окна (trackBar1) -->
                        <Border Grid.Row="3" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="8,6" Background="#FAFAFA">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="Прозрачность:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#555555"/>
                                <Slider Grid.Column="1" x:Name="trackBar1" Minimum="20" Maximum="100" Value="100"
                                        ValueChanged="trackBar1_ValueChanged"/>
                                <TextBlock Grid.Column="2" x:Name="lblOpacity" Text="100%" Width="45"
                                           VerticalAlignment="Center" TextAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
